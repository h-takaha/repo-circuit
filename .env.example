# GitHub fine-grained PAT（対象: h-takaha の全 repo）
#   Issues: Read and write / Pull requests: Read and write / Contents: Read and write
#   Actions: Read and write（失敗した検査の再実行）/ Checks: Read（検査結果の取得）/ Metadata: Read
# 空のままならデモモード（サンプルデータ・書き込みは擬似実行）で起動する
GITHUB_TOKEN=
GITHUB_OWNER=h-takaha

# Basic 認証（未設定だと全ページ 401 = fail-closed。/healthz だけ例外）
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=

# 操作の確認用トークン（CSRF）の元になる秘密値。任意。空なら BASIC_AUTH_PASSWORD から作る。
# 再起動しても開いたままのページで操作を続けられるよう、固定値から導出している
CSRF_SECRET=

# 作業台・本番・agent-ops の場所（読み取りのみ）
LAB_GIT_DIR=C:/lab/git
LAB_RUN_DIR=C:/lab/run
AGENT_OPS_DIR=C:/lab/git/agent-ops

# ブレーカーの記録（guard-log.jsonl）の置き場。git 外
REPO_CIRCUIT_DATA_DIR=C:/lab/data/repo-circuit
CACHE_TTL_SECONDS=60
